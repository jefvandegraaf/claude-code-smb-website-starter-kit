# Cloudflare Pages headers. Keep this file.

# Preview and .pages.dev copies of the site must never appear in Google.
# ":project" and ":alias" are Cloudflare placeholders. Leave them exactly as written.
https://:project.pages.dev/*
  X-Robots-Tag: noindex

https://:alias.:project.pages.dev/*
  X-Robots-Tag: noindex

# Basic security headers for every page.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()
